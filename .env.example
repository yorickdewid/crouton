# Copy this file to .env and adjust values for your environment.

# Croutond orchestrator endpoint used by the Bun backend.
CROUTOND_URL=http://[::1]:7777

# Optional: force frontend to call a specific Crouton API/WS base.
# Leave empty for same-origin.
# CROUTON_UI_API_BASE=https://ops.example.net:3000
# CROUTON_UI_WS_BASE=wss://ops.example.net:3000
